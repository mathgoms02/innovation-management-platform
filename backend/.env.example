# ---- Django core ----
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Database ----
# Unset -> local SQLite. In production point to Postgres:
# DATABASE_URL=postgres://imp:imp@db:5432/imp
# DATABASE_URL=

# ---- Channels / WebSockets ----
# Required in production (dev falls back to redis://127.0.0.1:6379/1).
REDIS_URL=redis://127.0.0.1:6379/1

# ---- Security (only enforced when DEBUG=False) ----
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# CSRF_TRUSTED_ORIGINS=https://app.example.com

# ---- Throttling (requests per period) ----
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=5/min

# ---- Email (password reset / verification) ----
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.com
FRONTEND_URL=http://localhost:5173
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
